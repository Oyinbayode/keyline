{
  "name": "@oyinbayode/keyline",
  "version": "0.2.0",
  "description": "Accessible React components with a keyboard and screen-reader contract you can read and test.",
  "keywords": [
    "react",
    "accessibility",
    "a11y",
    "wai-aria",
    "components",
    "switch",
    "tabs",
    "dialog",
    "menu",
    "toast"
  ],
  "homepage": "https://oyinbayode.github.io/keyline/",
  "bugs": "https://github.com/Oyinbayode/keyline/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oyinbayode/keyline.git"
  },
  "license": "MIT",
  "author": "Oyinbayode Akinleye",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dialog": {
      "import": {
        "types": "./dist/dialog.d.mts",
        "default": "./dist/dialog.js"
      },
      "require": {
        "types": "./dist/dialog.d.cts",
        "default": "./dist/dialog.cjs"
      }
    },
    "./menu": {
      "import": {
        "types": "./dist/menu.d.mts",
        "default": "./dist/menu.js"
      },
      "require": {
        "types": "./dist/menu.d.cts",
        "default": "./dist/menu.cjs"
      }
    },
    "./switch": {
      "import": {
        "types": "./dist/switch.d.mts",
        "default": "./dist/switch.js"
      },
      "require": {
        "types": "./dist/switch.d.cts",
        "default": "./dist/switch.cjs"
      }
    },
    "./tabs": {
      "import": {
        "types": "./dist/tabs.d.mts",
        "default": "./dist/tabs.js"
      },
      "require": {
        "types": "./dist/tabs.d.cts",
        "default": "./dist/tabs.cjs"
      }
    },
    "./toast": {
      "import": {
        "types": "./dist/toast.d.mts",
        "default": "./dist/toast.js"
      },
      "require": {
        "types": "./dist/toast.d.cts",
        "default": "./dist/toast.cjs"
      }
    },
    "./primitives": {
      "import": {
        "types": "./dist/primitives.d.mts",
        "default": "./dist/primitives.js"
      },
      "require": {
        "types": "./dist/primitives.d.cts",
        "default": "./dist/primitives.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && node scripts/build-css.ts && node scripts/check-dir-selectors.ts dist",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "size": "size-limit",
    "check:package": "publint && attw --pack . --profile node16 --exclude-entrypoints styles.css tokens.css",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build --quiet && node scripts/check-dir-selectors.ts storybook-static/assets",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.14.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@guidepup/virtual-screen-reader": "^0.33.0",
    "@microsoft/api-extractor": "^7.60.1",
    "@playwright/test": "^1.64.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "lightningcss": "^1.33.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "size-limit": "^14.3.0",
    "storybook": "^10.6.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "vitest-axe": "1.0.0-pre.5"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
